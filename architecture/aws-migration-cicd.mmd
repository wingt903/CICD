flowchart TB
    Team[Project / Migration Team]
    I1[New app onboarding request]
    I2[Existing app technical change]
    I3[Cyber remediation migration wave]

    subgraph S0[Notation]
        direction LR
        LegendManual["[M] Manual process"]
        LegendSystem["[S] System process"]
    end

    subgraph S1[Stage 1 - Intake and Architecture Governance]
        direction TB

        subgraph A_TPAM[TPAM]
            direction TB
            A1[Draft or update HLD and non-functional requirements]
            A2{App exists in ServiceNow CMDB inventory?}
            A4[Notify CAR team to create CMDB record]
            A8[Update artifacts per CAR feedback]
        end

        subgraph A_CAR_TEAM[CAR Team]
            direction TB
            A5[Create CMDB CI record]
        end

        subgraph A_CAR_ARCH[CAR Architect]
            direction TB
            A6[Review HLD and NFR]
            A7{Approval granted?}
        end

        subgraph A_SN["ServiceNow (Phase 2 target state / Phase 1 manual handoff)"]
            direction TB
            A10[Project team creates ServiceNow service request]
            A11{ServiceNow request approved?}
            A12[Update request and resubmit for approval]
        end

        subgraph A_GH[GitHub]
            direction TB
            A9[Stage handoff to CI/CD orchestration]
        end

        A1 --> A2
        A2 -- No --> A4 --> A5 --> A6
        A2 -- Yes --> A6
        A6 --> A7
        A7 -- No --> A8 --> A6
        A7 -- Yes --> A10 --> A11
        A11 -- No --> A12 --> A10
        A11 -- Yes --> A9
    end

    subgraph S2[Stage 2 - CI/CD Orchestration and Quality Gates]
        direction TB
        B1[Generate GitHub dispatch payload / governed manual trigger]
        B2[Checkout source and IaC from single multi-env repo or env-specific repo]
        B2A[Load approved RTCM from repo and SSM Parameter Store]
        B2B[Validate app middleware and database versions against RTCM]
        B3[Build and run quality and security checks]
        B4{All policy gates passed?}
        B5[Open remediation task with RTCM and policy rejection detail]
        B1 --> B2 --> B2A --> B2B --> B3 --> B4
        B4 -- No --> B5
    end

    subgraph S3[Stage 3 - Secure AWS Build Execution]
        direction TB
        C1[Assume AWS role via OIDC]
        C2[Launch private builder via SSM]
        C3[Run Ansible image build over SSM tunnel]
        C1 --> C2 --> C3
    end

    subgraph S4[Stage 4 - Middleware Configuration and AMI Serialization]
        direction TB
        D1{Select middleware profile}
        D2A[Apply WebLogic baseline]
        D2B[Apply Tomcat baseline]
        D2C[Apply Python baseline]
        D3[Register immutable golden AMI and capture evidence]
        D1 -- WebLogic --> D2A --> D3
        D1 -- Tomcat --> D2B --> D3
        D1 -- Python --> D2C --> D3
    end

    subgraph S5[Stage 5 - Promotion, Deployment, and CMDB Feedback]
        direction TB
        E1["Prepare CMDB and change evidence update<br/>(auto patch in Phase 2)"]
        E2{Promotion criteria met for target environment?}
        E3[Deploy via Terraform and ASG through dev -> test -> prod]
        E4[Execute rollback or remediation path]
        E1 --> E2
        E2 -- Yes --> E3
        E2 -- No --> E4
    end

    Team --> I1
    Team --> I2
    Team --> I3
    I1 --> A1
    I2 --> A1
    I3 --> A1

    A9 --> B1
    B4 -- Yes --> C1
    C3 --> D1
    D3 --> E1
    E4 --> B1

