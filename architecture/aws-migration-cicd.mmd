flowchart TD
    %% Styling to mimic process-document workflow boards
    classDef step fill:#f7f7f7,stroke:#6c6c6c,stroke-width:1.5px,color:#000;
    classDef decision fill:#ffffff,stroke:#444,stroke-width:1.5px,color:#000;
    classDef action fill:#e8f0fe,stroke:#1a73e8,stroke-width:1.5px,color:#000;
    classDef governance fill:#fdecea,stroke:#d93025,stroke-width:1.5px,color:#000;

    %% ---------------------------
    %% Process 1 - New application
    %% ---------------------------
    subgraph P1["Process 1 - New application onboarding"]
        direction LR
        A1[New migration request raised<br/>by project team] --> A2[Create / update CI data in CMDB]
        A2 --> A3[Draft HLD and target migration scope]
        A3 --> A4{ADR approval<br/>for HLD?}
        A4 -- Rejected --> A5[Update HLD]
        A5 --> A4
        A4 -- Approved --> A6[Write minimal viable LLD<br/>for first build]
        A6 --> A7{ADR approval<br/>for LLD?}
        A7 -- Rejected --> A8[Update LLD]
        A8 --> A7
        A7 -- Approved --> A9[Start CI/CD pipeline build]
        A9 --> A10[As build progresses,<br/>update LLD evidence]
        A10 --> A11[Delivery workshop<br/>with service design + ops]
        A11 --> A12{Final sign-off<br/>completed?}
        A12 -- Rejected --> A8
        A12 -- Approved --> A13[Release architecture pack<br/>and close governance gate]
    end

    %% ---------------------------
    %% Process 2 - Updated app
    %% ---------------------------
    subgraph P2["Process 2 - Updated application"]
        direction LR
        B1[Technical change requested<br/>for existing application] --> B2{Does it change NFR<br/>or architecture risk?}
        B2 -- Yes --> B3[Update HLD]
        B3 --> B4{ADR approval<br/>for HLD update?}
        B4 -- Rejected --> B3
        B4 -- Approved --> B5[Continue delivery]
        B2 -- No --> B6{Does it change deployed<br/>runtime / middleware?}
        B6 -- Yes --> B7[Update LLD]
        B7 --> B8{ADR approval<br/>for LLD update?}
        B8 -- Rejected --> B7
        B8 -- Approved --> B5
        B6 -- No --> B9[Architecture review confirms<br/>no document updates required]
        B9 --> B5
    end

    %% --------------------------------
    %% Process 3 - Cyber remediation
    %% --------------------------------
    subgraph P3["Process 3 - Cyber remediation and migration execution"]
        direction LR
        C1[Application selected for migration wave] --> C2[Validate business app + service mapping in CMDB]
        C2 --> C3[Generate GitHub dispatch payload<br/>app_id, middleware_type, env, change_id]
        C3 --> C4[GitHub Actions checkout + quality gates]
        C4 --> C5[Assume AWS role via OIDC]
        C5 --> C6[Run Ansible over SSM to build golden AMI]
        C6 --> C7{Middleware type?}
        C7 -- weblogic --> C8[Provision WebLogic domain baseline]
        C7 -- tomcat --> C9[Deploy WAR and tune JVM]
        C7 -- python --> C10[Create venv and install dependencies]
        C8 --> C11[Register AMI + collect SSM evidence]
        C9 --> C11
        C10 --> C11
        C11 --> C12[Patch ServiceNow / CMDB with AMI + evidence]
        C12 --> C13{Promotion criteria met<br/>for target env?}
        C13 -- No --> C14[Open remediation task and loop back]
        C14 --> C4
        C13 -- Yes --> C15[Terraform / ASG rollout with approved AMI]
    end

    class A1,A2,A3,A5,A6,A8,A9,A10,A11,A13,B1,B3,B5,B7,B9,C1,C2,C3,C4,C5,C6,C8,C9,C10,C11,C12,C14,C15 step;
    class A4,A7,A12,B2,B4,B6,B8,C7,C13 decision;
    class B5,C15 action;
    class A13,C14 governance;
