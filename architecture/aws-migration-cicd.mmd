flowchart TB
    %% Professional styling
    classDef stage fill:#f7f7f7,stroke:#6c6c6c,stroke-width:1.5px,color:#000;
    classDef decision fill:#ffffff,stroke:#444,stroke-width:1.5px,color:#000;
    classDef action fill:#e8f0fe,stroke:#1a73e8,stroke-width:1.5px,color:#000;
    classDef governance fill:#fdecea,stroke:#d93025,stroke-width:1.5px,color:#000;
    classDef manualProcess fill:#fff8e1,stroke:#ef6c00,stroke-width:1.5px,color:#000;
    classDef systemProcess fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px,color:#000;
    classDef legend fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1px,color:#000;

    I1[New app onboarding request]
    I2[Existing app technical change]
    I3[Cyber remediation migration wave]

    subgraph S0[Notation]
        direction LR
        L1[✍️ Manual process]
        L2[⚙️ System process]
        L3[🏷️ Actor lane header indicates process owner]
    end

    subgraph S1[Stage 1 - Intake and Architecture Governance]
        direction TB

        subgraph A_TPAM[TPAM]
            direction TB
            A1[Draft or update HLD and non-functional requirements]
            A2{App exists in ServiceNow CMDB inventory?}
            A4[Notify CAR team to create CMDB record]
            A8[Update artifacts per CAR feedback]
        end

        subgraph A_CAR_TEAM[CAR Team]
            direction TB
            A5[Create CMDB CI record]
        end

        subgraph A_CAR_ARCH[CAR Architect]
            direction TB
            A6[Review HLD and NFR]
            A7{Approval granted?}
        end

        subgraph A_GH[GitHub]
            direction TB
            A9[Stage handoff to CI/CD orchestration]
        end

        A1 --> A2
        A2 -- No --> A4 --> A5 --> A6
        A2 -- Yes --> A6
        A6 --> A7
        A7 -- No --> A8 --> A6
        A7 -- Yes --> A9
    end

    subgraph S2[Stage 2 - CI/CD Orchestration and Quality Gates]
        direction TB
        B1[Generate GitHub dispatch payload]
        B2[Checkout source and IaC]
        B3[Build and run quality and security checks]
        B4{Pipeline gates passed?}
        B5[Open remediation task]
        B1 --> B2 --> B3 --> B4
        B4 -- No --> B5
    end

    subgraph S3[Stage 3 - Secure AWS Build Execution]
        direction TB
        C1[Assume AWS role via OIDC]
        C2[Launch private builder via SSM]
        C3[Run Ansible image build over SSM tunnel]
        C1 --> C2 --> C3
    end

    subgraph S4[Stage 4 - Middleware Configuration and AMI Serialization]
        direction TB
        D1{Which middleware profile applies?}
        D2[Apply WebLogic, Tomcat, or Python baseline]
        D3[Register immutable golden AMI and capture evidence]
        D1 --> D2 --> D3
    end

    subgraph S5[Stage 5 - Promotion, Deployment, and CMDB Feedback]
        direction TB
        E1[Patch CMDB and change record with AMI and evidence]
        E2{Promotion criteria met for target environment?}
        E3[Deploy via Terraform and ASG through dev to test to prod]
        E4[Execute rollback or remediation path]
        E1 --> E2
        E2 -- Yes --> E3
        E2 -- No --> E4
    end

    I1 --> A1
    I2 --> A1
    I3 --> A1

    A9 --> B1
    B4 -- Yes --> C1
    C3 --> D1
    D3 --> E1
    E4 --> B1

    class I1,I2,I3 stage;
    class A2,A7,B4,D1,E2 decision;
    class E3 action;
    class B5,E4 governance;
    class A1,A2,A4,A5,A6,A7,A8 manualProcess;
    class A9,B1,B2,B3,B4,B5,C1,C2,C3,D1,D2,D3,E1,E3,E4 systemProcess;
    class L1,L2,L3 legend;
    class L1 manualProcess;
    class L2 systemProcess;
