C4Component
    title C4 Component — CI/CD Pipeline (L3)

    Container_Boundary(pipeline, "CI/CD Pipeline (GitHub Actions)") {
        Component(trigger, "Trigger Handler", "GitHub Events / workflow_dispatch", "Starts and sequences pipeline runs")
        Component(oidcMod, "OIDC Auth", "GitHub OIDC / AWS STS", "Gets short-lived AWS credentials")
        Component(rtcmGate, "RTCM Gate", "Shell / Python", "Validates runtime versions vs approved baseline")
        Component(secGate, "Security Gate", "CodeQL · Semgrep · Trivy · gitleaks · tfsec · Checkov", "Runs scans and blocks on failed policy")
        Component(imgBuild, "Image Builder", "Ansible · SSM Session Manager", "Builds and hardens Golden AMIs on private EC2")
        Component(artMgr, "Artifact Manager", "GitHub Actions", "Publishes images/packages and writes approved parameters")
        Component(deployer, "Deployment Controller", "GitHub Environments / Release Manifest", "Controls dev→test→prod promotion with approvals")
        Component(govGuard, "No-Redeploy Guard", "SSM Decision Records", "Blocks redeploy of failed releases")
        Component(evidEmit, "Evidence Emitter", "AWS EventBridge", "Emits compliance events to evidence bus")
    }

    System_Ext(appRepos, "Application Repositories", "GitHub repos for app, Terraform, and Ansible")
    Container_Ext(oidcProv, "IAM OIDC Provider", "AWS IAM", "Issues temporary STS credentials")
    ContainerDb_Ext(ssmParam, "SSM Parameter Store", "AWS SSM", "Holds RTCM baseline and runtime parameters")
    ContainerDb_Ext(ssmDrec, "SSM Decision Records", "AWS SSM", "Holds per-release deploy decisions")
    Container_Ext(ssmSess, "SSM Session Manager", "AWS SSM", "Secure channel to private builder EC2")
    Container_Ext(buildHost, "Private Builder EC2 + Ansible", "EC2 / Ansible", "Runs image build playbooks")
    Container_Ext(ecr, "Amazon ECR", "AWS ECR", "Container registry")
    Container_Ext(ca, "AWS CodeArtifact", "AWS CodeArtifact", "Package registry")
    Container_Ext(ghEnv, "GitHub Environments", "GitHub", "Manual approval gates")
    Container_Ext(evtBus, "EventBridge Evidence Bus", "AWS EventBridge", "Routes compliance events")
    Container_Ext(compStore, "Compliance Evidence Store", "S3 + DynamoDB + Lambda", "Stores audit evidence")

    Rel(appRepos, trigger, "push / workflow_dispatch")
    Rel(trigger, oidcMod, "requests AWS credentials")
    Rel(oidcMod, oidcProv, "exchanges OIDC for STS credentials")
    Rel(trigger, rtcmGate, "runs RTCM validation")
    Rel(ssmParam, rtcmGate, "supplies approved baseline")
    Rel(trigger, secGate, "runs code, dependency, secret, and IaC scans")
    Rel(rtcmGate, secGate, "forwards gate evidence")
    Rel(secGate, imgBuild, "passes gate; starts image build")
    Rel(imgBuild, ssmSess, "opens secure channel")
    Rel(ssmSess, buildHost, "routes commands")
    Rel(imgBuild, buildHost, "executes Ansible playbooks")
    Rel(ssmParam, buildHost, "supplies build parameters")
    Rel(trigger, artMgr, "starts artifact publishing")
    Rel(artMgr, ecr, "pushes container images")
    Rel(artMgr, ca, "publishes Python / Java packages")
    Rel(artMgr, ssmParam, "writes AMI paths and env parameters")
    Rel(trigger, govGuard, "checks decision record before deploy")
    Rel(govGuard, ssmDrec, "reads and writes deployment decisions")
    Rel(trigger, deployer, "starts env promotion")
    Rel(deployer, ghEnv, "requests promotion approval")
    Rel(trigger, evidEmit, "emits pipeline and gate events")
    Rel(evidEmit, evtBus, "publishes compliance events")
    Rel(evtBus, compStore, "routes events for ingestion")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
