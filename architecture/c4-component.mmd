C4Component
    title Component Diagram — CI/CD Pipeline Container (GitHub Actions) — Level 3

    Container_Boundary(pipeline, "CI/CD Pipeline — GitHub Actions") {
        Component(trigger, "Pipeline Trigger Handler", "GitHub Events / workflow_dispatch", "Receives push events and workflow dispatch calls from application repositories; coordinates the overall pipeline run sequence")
        Component(oidcMod, "OIDC Auth Module", "GitHub Actions OIDC / AWS STS", "Exchanges the GitHub-issued OIDC JWT for short-lived AWS STS credentials scoped to the permitted IAM role; no long-lived credentials stored")
        Component(rtcmGate, "RTCM Validation Gate", "Shell / Python", "Compares declared middleware and database versions in the application stack against the approved runtime compatibility baseline retrieved from SSM Parameter Store; blocks build on mismatch")
        Component(secGate, "Security Scan Gate", "CodeQL · Semgrep · Trivy · gitleaks · tfsec · Checkov", "Runs SAST, dependency vulnerability, secret detection, and IaC misconfiguration scans; aggregates pass/fail evidence and blocks progression on any finding above threshold")
        Component(imgBuild, "Image Build Orchestrator", "Ansible · SSM Session Manager", "Opens an SSM Session Manager channel to the private builder EC2; invokes Ansible playbook to install runtimes, apply OS hardening, and produce a candidate Golden AMI")
        Component(artMgr, "Artifact Manager", "GitHub Actions Steps", "Pushes immutable-tagged container images to ECR, publishes versioned Python and Java packages to CodeArtifact, and writes approved AMI paths and environment parameters to SSM Parameter Store")
        Component(deployer, "Deployment Controller", "GitHub Environments / Release Manifest", "Enforces environment promotion gates (dev → test → prod) via GitHub Environments manual approvals; captures release manifest containing digest, AMI ID, and IaC version for traceability")
        Component(govGuard, "No-Redeploy Governor", "SSM Decision Records", "Reads SSM Decision Records before each deployment to block re-deployment of a release marked as failed; writes the pass/fail outcome after every run")
        Component(evidEmit, "Evidence Emitter", "AWS EventBridge", "Publishes structured compliance evidence events (scan results, gate outcomes, deployment records) to the EventBridge Evidence Bus for ingestion by the Compliance Evidence Store")
    }

    System_Ext(appRepos, "Application Repositories", "GitHub repositories containing application code, Terraform IaC, and Ansible image build config")
    Container_Ext(oidcProv, "IAM OIDC Provider", "AWS IAM", "Validates GitHub OIDC tokens and issues temporary STS credentials")
    ContainerDb_Ext(ssmParam, "SSM Parameter Store", "AWS SSM", "Stores approved RTCM baseline, Golden AMI paths, build parameters, and environment-specific values")
    ContainerDb_Ext(ssmDrec, "SSM Decision Records", "AWS SSM", "Stores deployment pass/fail decisions keyed by release ID and environment")
    Container_Ext(ssmSess, "SSM Session Manager", "AWS SSM", "Provides encrypted channel to private builder EC2 without SSH or console access")
    Container_Ext(buildHost, "Private Builder EC2 + Ansible", "EC2 / Ansible", "Executes Ansible playbooks to build and harden Golden AMIs")
    Container_Ext(ecr, "Amazon ECR", "AWS ECR", "Immutable-tag container image registry")
    Container_Ext(ca, "AWS CodeArtifact", "AWS CodeArtifact", "Versioned Python and Java package registry")
    Container_Ext(ghEnv, "GitHub Environments", "GitHub", "Enforces manual approval gates for environment promotion (dev / test / prod)")
    Container_Ext(evtBus, "EventBridge Evidence Bus", "AWS EventBridge", "Routes compliance evidence events to the Compliance Evidence Store")
    Container_Ext(compStore, "Compliance Evidence Store", "S3 + DynamoDB + Lambda", "Ingests, indexes, and immutably stores all compliance evidence for audit")

    Rel(appRepos, trigger, "push / workflow_dispatch")
    Rel(trigger, oidcMod, "requests AWS credentials")
    Rel(oidcMod, oidcProv, "exchanges OIDC token for STS credentials")
    Rel(trigger, rtcmGate, "invokes RTCM version validation")
    Rel(ssmParam, rtcmGate, "supplies approved runtime baseline")
    Rel(trigger, secGate, "triggers SAST, dependency, secret and IaC scans")
    Rel(rtcmGate, secGate, "forwards RTCM gate evidence")
    Rel(secGate, imgBuild, "passes security gate evidence; initiates image build")
    Rel(imgBuild, ssmSess, "opens SSM secure channel")
    Rel(ssmSess, buildHost, "routes build commands to builder EC2")
    Rel(imgBuild, buildHost, "drives Ansible playbook execution")
    Rel(ssmParam, buildHost, "supplies build-time parameters")
    Rel(trigger, artMgr, "invokes artifact publishing after build")
    Rel(artMgr, ecr, "pushes container images")
    Rel(artMgr, ca, "publishes Python / Java packages")
    Rel(artMgr, ssmParam, "writes approved AMI paths and env parameters")
    Rel(trigger, govGuard, "checks release decision record before deploy")
    Rel(govGuard, ssmDrec, "reads and writes deployment decisions")
    Rel(trigger, deployer, "initiates environment promotion")
    Rel(deployer, ghEnv, "requests manual approval for promotion gate")
    Rel(trigger, evidEmit, "emits pipeline, gate, and deployment events")
    Rel(evidEmit, evtBus, "publishes structured compliance events")
    Rel(evtBus, compStore, "routes events for ingestion")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
