C4Component
    title C4 Component - Drift and Audit Flow (L3)

    Container_Boundary(pipeline, "CI/CD Pipeline - GitHub Actions") {
        Component(trigger, "Trigger Handler", "GitHub Events / workflow_dispatch", "Starts the governed pipeline after commit approval")
        Component(oidcMod, "OIDC Auth", "GitHub OIDC / AWS STS", "Gets short-lived AWS credentials")
        Component(baselinePub, "Baseline Publisher", "GitHub Actions / Release Manifest", "Publishes the approved baseline after a governed commit is accepted")
        Component(driftSched, "Scheduled Drift Scan", "EventBridge Scheduler", "Starts recurring drift scans against the approved baseline")
        Component(stateCollect, "State Collector", "AWS Config / SSM / Runtime APIs", "Collects current infrastructure and database state")
        Component(compareEngine, "Comparison Engine", "Lambda / Step Functions", "Compares live state with the approved baseline")
        Component(autoRemed, "Auto Remediation", "Terraform / Ansible / DB Migration", "Restores the approved baseline when drift is detected")
        Component(evidEmit, "Evidence Emitter", "AWS EventBridge", "Stores compliance and remediation events for audit")
    }

    System_Ext(appRepos, "Application Repositories", "GitHub repos for app, Terraform, and Ansible")
    Container_Ext(oidcProv, "IAM OIDC Provider", "AWS IAM", "Issues temporary STS credentials")
    Container_Ext(ssmParam, "Approved Baseline Store", "AWS SSM", "Holds the published approved baseline")
    Container_Ext(releaseManifest, "Release Manifest", "GitHub Artifact", "Captures the approved release baseline")
    Container_Ext(runtimeState, "Runtime State APIs", "AWS Config / SSM / DB Metadata", "Returns live state snapshots for comparison")
    Container_Ext(evtBus, "EventBridge Evidence Bus", "AWS EventBridge", "Routes compliance events")
    Container_Ext(auditS3, "S3 Audit and Evidence Store", "Amazon S3", "Stores immutable audit events and evidence for reporting")
    Container_Ext(datadog, "Datadog", "Observability / Dashboards", "Consumes audit events and remediation outcomes")
    

    Rel(appRepos, trigger, "push / workflow_dispatch")
    Rel(trigger, oidcMod, "requests AWS credentials")
    Rel(oidcMod, oidcProv, "exchanges OIDC for STS credentials")
    Rel(trigger, baselinePub, "publishes approved baseline")
    Rel(baselinePub, ssmParam, "writes approved baseline")
    Rel(baselinePub, releaseManifest, "stores approved release details")
    Rel(trigger, driftSched, "starts recurring drift control")
    Rel(driftSched, stateCollect, "starts scheduled state collection")
    Rel(runtimeState, stateCollect, "supplies live runtime state")
    Rel(stateCollect, compareEngine, "passes collected state")
    Rel(ssmParam, compareEngine, "supplies desired baseline")
    Rel(releaseManifest, compareEngine, "supplies approved release baseline")
    Rel(compareEngine, evidEmit, "writes compliant or drift-found event")
    Rel(compareEngine, autoRemed, "starts restore-to-baseline")
    Rel(autoRemed, evidEmit, "writes remediation outcome")
    Rel(evidEmit, evtBus, "publishes compliance events")
    Rel(evtBus, auditS3, "routes events for immutable storage")
    Rel(auditS3, datadog, "streams audit events")
    

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
