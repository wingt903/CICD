    style SAST fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    style IAC fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    style RTCM fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    style AMISCAN fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    style IGATE fill:#ffffff,stroke:#444444,stroke-width:1.5px,color:#000
    style RUNTIMESEC fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    %% aws
    style OIDC fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    style SSMSESS fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    style PARAM fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    style INV fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    style AMI fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    %% runtime
    style EC2 fill:#E8F5E9,stroke:#1B5E20,stroke-width:2px,color:#000
    style APP fill:#E8F5E9,stroke:#1B5E20,stroke-width:2px,color:#000
    %% compliance evidence
    style EVTBUS fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style INGESTOR fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style EVIDENCES3 fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style EVIDX fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style INTVERIFY fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style CLOUDTRAIL fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style AUDITMAN fill:#EDE7F6,stroke:#4A148C,stroke-width:2px,color:#000
    style ATHENA fill:#EDE7F6,stroke:#4A148C,stroke-width:2px,color:#000
    style AUDITAPI fill:#EDE7F6,stroke:#4A148C,stroke-width:2px,color:#000
