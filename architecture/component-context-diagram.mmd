graph LR
    %% Styling
    classDef actor fill:#E1F5FE,stroke:#01579B,stroke-width:2px;
    classDef governance fill:#E8EAF6,stroke:#283593,stroke-width:2px;
    classDef pipeline fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px;
    classDef aws fill:#FFF3E0,stroke:#E65100,stroke-width:2px;
    classDef runtime fill:#E8F5E9,stroke:#1B5E20,stroke-width:2px;

    Team[Project / Migration Team]

    subgraph Governance["Trust Boundary: Governance & Request Layer"]
        SN[ServiceNow Catalog + CMDB]
        IH[IntegrationHub]
    end

    subgraph Pipeline["Trust Boundary: CI/CD Orchestration Layer"]
        GH[GitHub Repository]
        GHA[GitHub Actions]
        IMG[Ansible Image Build Playbooks]
        ANS[Ansible]
    end

    subgraph AWS["Trust Boundary: AWS Control Plane"]
        OIDC[AWS IAM OIDC Provider]
        SSMSESS[AWS SSM Session Manager]
        PARAM[AWS SSM Parameter Store]
        INV[AWS SSM Inventory]
        AMI[Golden AMI Registry]
    end

    subgraph Runtime["Trust Boundary: AWS Runtime / Build Targets"]
        EC2[Private Builder EC2]
        APP[Target Workloads\nWebLogic / Tomcat / Python]
    end

    Team -->|Submit service request| SN
    SN -->|Trigger workflow event| IH
    IH -->|Dispatch pipeline run| GHA
    SN -. CMDB metadata / change context .-> GHA

    GH -->|Push/PR pipeline trigger| GHA
    GHA -->|Request federated identity token| OIDC
    OIDC -->|Return temporary AWS credentials| GHA

    GHA -->|Invoke image build playbooks| IMG
    IMG -->|Run playbook execution| EC2
    SSMSESS -->|Open secure management session| EC2

    GHA -->|Start SSM automation/session| SSMSESS
    GHA -->|Launch configuration tasks| ANS
    ANS -->|Configure builder host| EC2
    PARAM -->|Provide approved build parameters| EC2

    EC2 -->|Publish hardened image| AMI
    AMI -->|Deploy image to workloads| APP
    EC2 -->|Send inventory state| INV
    INV -->|Sync inventory to CMDB| SN

    class Team actor;
    class SN,IH governance;
    class GH,GHA,IMG,ANS pipeline;
    class OIDC,SSMSESS,PARAM,INV,AMI aws;
    class EC2,APP runtime;
