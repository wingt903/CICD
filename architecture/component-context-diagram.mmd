%%{init: {'flowchart': {'nodeSpacing': 6, 'rankSpacing': 10, 'diagramPadding': 2, 'curve': 'linear'}}}%%
graph TB
    %% Edge labels: short verb phrases describe each flow; F1/F2/F3 = failure/remediation paths.
    %% Merged from component-context-diagram and target-component-context (single unified diagram).
    Team[Product Team]

    subgraph Governance["Governance & Request (Phase 2)"]
        direction LR
        SN[ServiceNow\nCatalog + CMDB]
        IH[IntegrationHub]
    end

    subgraph Sources["Code Sources"]
        direction LR
        APPCODE["Application Repo(s)<br/>One Repo per Env or One Repo for All Envs"]
        IMGCODE["OS / Image as Code Repo<br/>Ansible Image Build + Config"]
        IACCODE["Infrastructure as Code Repo<br/>Terraform"]
    end

    subgraph Pipeline["CI/CD Orchestration"]
        direction LR
        GHA[GitHub Actions]
        GHENV[GitHub Environments\ndev / test / prod]
        RELMANIFEST[Release Manifest\nDigest + AMI + IaC Version]
        RTCMVAL[RTCM Validation Gate]
        ANS[Ansible]
    end

    subgraph Security["Security & Quality Gates"]
        direction LR
        SAST[Code Scans\nSAST + Dep + Secret]
        IAC[IaC Scans\ntfsec + Checkov]
        SGATE{Security Gates\nPassed?}
        AMISCAN[Artifact Scans\nECR + Inspector]
        IGATE{Image Scan\nPassed?}
        RUNTIMESEC[Runtime Posture\nSecHub + GuardDuty + IAM AA]
    end

    subgraph AWS["AWS Control Plane"]
        direction LR
        OIDC[IAM OIDC\nProvider]
        SSMSESS[SSM Session\nManager]
        PARAM[SSM Parameter\nStore]
        DREC[SSM Decision\nRecords]
        INV[SSM\nInventory]
    end

    subgraph Artifacts["Artifact Management"]
        direction LR
        ECR[Amazon ECR\nImmutable Tags + Digest]
        CODEARTIFACT[AWS CodeArtifact\nPython / Java Packages]
        RTCM[RTCM\nApproved Versions]
        SBOM[SBOM + Build Provenance]
    end

    subgraph Build["Build Runtime"]
        direction LR
        EC2[Private Builder EC2]
        AMI[Golden AMI\nRegistry]
    end

    subgraph Runtime["AWS Runtime by Environment"]
        direction LR
        DEVACCT[Dev Account]
        TESTACCT[Test Account]
        PRODACCT[Prod Account]
        APP[Target Workloads\nWebLogic / Tomcat / Python]
        TFRUNTIME[Terraform Provisioned Runtime\nVPC IAM ECS/EKS/ASG ALB]
    end

    subgraph Ops["Operations & Rollback"]
        direction LR
        OBS[CloudWatch + OpenTelemetry + X-Ray]
        ALARMS[CloudWatch Alarms + SNS]
        BGROLL[Blue/Green or Canary Rollback]
        AMIROLL[AMI Rollback\nPrevious Approved ID]
        IACROLL[IaC Controlled\nRevert Pipeline]
    end

    subgraph Drift["Drift Detection & Reconciliation"]
        direction LR
        SCHED[EventBridge\nScheduler]
        DRIFTREC[Scheduled Drift Scan\nLambda / Step Function]
        STATECOLLECT[State Collection\nAWS Config + SSM + Runtime APIs]
        COMPARE[Comparison Engine\nBaseline vs Live State]
        DRIFTDEC{Drift Found?}
        COMPLIANT[Compliance State\nNo Drift Recorded]
        DRIFTEVENT[Store Event\nEvidence + Finding Record]
        ENFORCE[Auto Remediation\nTerraform Apply + Config Re-run]
    end

    subgraph DBDrift["Database Drift Management"]
        direction LR
        DBDETECT[Database Drift Detector\nSchema + Parameter Drift]
        DBMIG[Migration Orchestrator\nVersioned DB Migration Plan]
        DBROLL[DB Rollback Path\nSnapshot Restore + Previous Migration]
        DBVALID[Post-Remediation\nDB Validation]
    end

    subgraph Compliance["Compliance Evidence Store"]
        direction LR
        EVTBUS[EventBridge\nEvidence Bus]
        INGESTOR[Evidence Ingestor\nLambda]
        EVIDENCES3[S3 Evidence Bucket\nObject Lock + SSE-KMS]
        AUDITDB[Audit Database\nDynamoDB Evidence Index]
        INTVERIFY[Integrity Verifier\nLambda]
        CLOUDTRAIL[CloudTrail\nEvidence Audit]
    end

    subgraph Audit["Audit Reporting"]
        direction LR
        SPLUNK[Splunk\nAudit Event Search]
        GRAFANA[Grafana\nCompliance Dashboards]
    end

    %% Governance & Request (Phase 2)
    Team -->|1. submit request| SN
    SN -.->|"2. CMDB context (Phase 2)"| GHA
    SN -->|"3. trigger event (Phase 2)"| IH
    IH -->|"4. dispatch run (Phase 2)"| GHA
    SN -->|"F1: remediation notify (Phase 2)"| Team

    %% Pipeline Bootstrap
    APPCODE -->|5. code repo trigger| GHA
    IMGCODE -->|6. image repo trigger| GHA
    IACCODE -->|7. IaC repo trigger| GHA
    GHA -->|8. request token| OIDC
    OIDC -->|9. temp credentials| GHA

    %% RTCM & Security Scan Gates
    GHA -->|10. validate stack versions| RTCMVAL
    PARAM -->|11. mirror baseline| RTCM
    RTCM -->|12. version policy| RTCMVAL
    GHA -->|13. run code scans| SAST
    GHA -->|14. run IaC scans| IAC
    RTCMVAL -->|15. gate evidence| SGATE
    SAST -->|16. gate evidence| SGATE
    IAC -->|17. gate evidence| SGATE
    SGATE -->|18. passed: build| ANS
    SGATE -->|"F2: failed: remediation (Phase 2)"| SN

    %% Image Build
    GHA -->|19. start session| SSMSESS
    SSMSESS -->|20. secure channel| EC2
    GHA -->|21. launch config| ANS
    ANS -->|22. configure host| EC2
    PARAM -->|23. build params| EC2
    EC2 -->|24. publish AMI| AMI

    %% Artifact Management
    GHA -->|25. push image| ECR
    GHA -->|26. publish packages| CODEARTIFACT
    GHA -->|27. store params| PARAM
    GHA -->|28. publish RTCM baseline| RTCM
    GHA -->|29. generate SBOM| SBOM
    SBOM -->|30. build provenance| RELMANIFEST

    %% AMI Scan & Deploy
    AMI -->|31. scan candidate| AMISCAN
    AMISCAN -->|32. scan evidence| IGATE
    IGATE -->|33. passed: deploy| GHENV
    IGATE -->|"F3: failed: remediation (Phase 2)"| SN
    EC2 -->|34. inventory state| INV
    INV -->|"35. sync to CMDB (Phase 2)"| SN

    %% No-Redeploy Governance
    GHA -->|36. check release status| DREC
    DREC -->|37. allow/block deploy| GHA
    GHA -->|38. write pass/fail| DREC
    DREC -->|"39. no-redeploy policy (Phase 2)"| SN

    %% Release Promotion
    GHENV -->|40. capture release| RELMANIFEST
    RELMANIFEST -->|41. deploy dev| DEVACCT
    DEVACCT -->|42. provision runtime| TFRUNTIME
    DEVACCT -->|43. promote test| TESTACCT
    TESTACCT -->|44. promote prod| PRODACCT
    PRODACCT -->|45. deploy workloads| APP

    %% Runtime Security
    AMISCAN -->|46. scan dev artifacts| DEVACCT
    AMISCAN -->|47. scan test artifacts| TESTACCT
    AMISCAN -->|48. scan prod artifacts| PRODACCT
    APP -->|49. posture telemetry| RUNTIMESEC
    RUNTIMESEC -->|"50. posture feedback (Phase 2)"| SN

    %% Operations & Rollback
    TFRUNTIME -->|51. emit telemetry| OBS
    OBS -->|52. trigger alarms| ALARMS
    ALARMS -->|53. canary rollback| BGROLL
    ALARMS -->|54. AMI rollback| AMIROLL
    ALARMS -->|55. IaC revert| IACROLL

    %% Drift Detection & Reconciliation
    SCHED -->|56. scheduled drift scan| DRIFTREC
    DEVACCT -->|57. dev live state| STATECOLLECT
    TESTACCT -->|58. test live state| STATECOLLECT
    PRODACCT -->|59. prod live state| STATECOLLECT
    IACCODE -->|60. Terraform baseline| COMPARE
    RELMANIFEST -->|61. approved release baseline| COMPARE
    DRIFTREC -->|62. collect state| STATECOLLECT
    STATECOLLECT -->|63. current state snapshot| COMPARE
    COMPARE -->|64. drift decision| DRIFTDEC
    DRIFTDEC -->|65. no drift| COMPLIANT
    DRIFTDEC -->|66. drift found| DRIFTEVENT
    DRIFTEVENT -->|67. trigger remediation| ENFORCE
    ENFORCE -->|68. remediation outcome| DRIFTEVENT
    COMPLIANT -->|69. compliant evidence| RUNTIMESEC
    DRIFTEVENT -->|"70. drift event (Phase 2)"| SN

    %% Database Drift Management
    TFRUNTIME -->|71. runtime schema| DBDETECT
    DBDETECT -->|72. migration plan| DBMIG
    DBMIG -->|73. validate migration| DBVALID
    DBMIG -->|74. rollback path| DBROLL
    DBROLL -->|75. validate rollback| DBVALID
    DBVALID -->|76. DB findings| DRIFTEVENT

    %% Evidence Flows
    GHA -->|77. pipeline evidence| EVTBUS
    RTCMVAL -->|78. RTCM evidence| EVTBUS
    SAST -->|79. scan evidence| EVTBUS
    IAC -->|80. IaC evidence| EVTBUS
    AMISCAN -->|81. image evidence| EVTBUS
    RUNTIMESEC -->|82. posture evidence| EVTBUS
    INV -->|83. inventory evidence| EVTBUS
    COMPLIANT -->|84. compliance evidence| EVTBUS
    DBVALID -->|85. DB evidence| EVTBUS
    DRIFTEVENT -->|86. drift evidence| EVTBUS
    EVTBUS -->|87. validate + ingest| INGESTOR
    INGESTOR -->|88. write record| EVIDENCES3
    INGESTOR -->|89. update audit db| AUDITDB
    EVIDENCES3 -->|90. daily check| INTVERIFY
    INTVERIFY -->|91. tamper alert| CLOUDTRAIL
    EVIDENCES3 -->|92. S3 events| CLOUDTRAIL

    %% Audit Reporting
    AUDITDB -->|93. search audit events| SPLUNK
    AUDITDB -->|94. feed compliance views| GRAFANA
    EVIDENCES3 -->|95. immutable evidence drill-down| SPLUNK

