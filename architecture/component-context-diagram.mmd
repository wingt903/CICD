%%{init: {'flowchart': {'nodeSpacing': 6, 'rankSpacing': 10, 'diagramPadding': 2, 'curve': 'linear'}}}%%
graph TB
    %% Edge labels: numbers 1-48 = sequential workflow steps; F1/F2/F3 = failure/remediation paths.
    %% Full step descriptions are in architecture/full-pipeline-tech-stack.md.
    Team[Project / Migration Team]

    subgraph Governance["Governance & Request"]
        direction LR
        SN[ServiceNow\nCatalog + CMDB]
        IH[IntegrationHub]
    end

    subgraph Pipeline["CI/CD Orchestration"]
        direction LR
        GH[GitHub\nRepository]
        GHA[GitHub Actions]
        RTCMVAL[RTCM Validator]
        IMG[Ansible Image Build]
        ANS[Ansible]
        SGATE{Security Gates\nPassed?}
    end

    subgraph Security["Security & Quality Gates"]
        direction LR
        SAST[Code Scans\nSAST + Dep + Secret]
        IAC[IaC Scans\ntfsec + Checkov]
        RTCM[RTCM\nApproved Versions]
        AMISCAN[Artifact Scans\nECR + Inspector]
        IGATE{Image Scan\nPassed?}
        RUNTIMESEC[Runtime Posture\nSecHub + GuardDuty + IAM AA]
    end

    subgraph AWS["AWS Control Plane"]
        direction LR
        OIDC[IAM OIDC\nProvider]
        SSMSESS[SSM Session\nManager]
        PARAM[SSM Parameter\nStore]
        INV[SSM\nInventory]
        AMI[Golden AMI\nRegistry]
    end

    subgraph Compliance["Compliance Evidence & Audit"]
        direction LR
        EVTBUS[EventBridge\nEvidence Bus]
        INGESTOR[Evidence Ingestor\nLambda]
        EVIDENCES3[S3 Evidence Bucket\nObject Lock + SSE-KMS]
        EVIDX[DynamoDB\nEvidence Index]
        INTVERIFY[Integrity Verifier\nLambda]
        CLOUDTRAIL[CloudTrail\nEvidence Audit Log]
        AUDITMAN[Audit Manager]
        ATHENA[Athena\nReport Queries]
        AUDITAPI[Auditor\nExport API]
    end

    subgraph Runtime["AWS Runtime / Build Targets"]
        direction LR
        EC2[Private Builder EC2]
        APP[Target Workloads\nWebLogic / Tomcat / Python]
    end

    %% Governance → Pipeline
    SN -.->|1| GHA
    SN -->|2| IH
    IH -->|3| GHA
    SN -->|F3| Team

    %% Pipeline bootstrap
    GH -->|4| GHA
    GHA -->|5| OIDC
    OIDC -->|6| GHA

    %% RTCM + security scan gates
    GH -->|7| RTCM
    PARAM -->|8| RTCM
    GHA -->|9| RTCMVAL
    RTCM -->|10| RTCMVAL
    GHA -->|11| SAST
    GHA -->|12| IAC
    RTCMVAL -->|13| SGATE
    SAST -->|14| SGATE
    IAC -->|15| SGATE
    SGATE -->|16| IMG
    SGATE -->|F1| SN

    %% Image build
    IMG -->|17| EC2
    GHA -->|18| SSMSESS
    SSMSESS -->|19| EC2
    GHA -->|20| ANS
    ANS -->|21| EC2
    PARAM -->|22| EC2

    %% AMI scan + deploy
    EC2 -->|23| AMI
    AMI -->|24| AMISCAN
    AMISCAN -->|25| IGATE
    IGATE -->|26| APP
    IGATE -->|F2| SN
    EC2 -->|27| INV
    INV -->|28| SN
    APP -->|29| RUNTIMESEC
    RUNTIMESEC -->|30| SN

    %% Evidence flows
    GHA -->|31| EVTBUS
    RTCMVAL -->|32| EVTBUS
    SAST -->|33| EVTBUS
    IAC -->|34| EVTBUS
    AMISCAN -->|35| EVTBUS
    RUNTIMESEC -->|36| EVTBUS
    INV -->|37| EVTBUS
    EVTBUS -->|38| INGESTOR
    INGESTOR -->|39| EVIDENCES3
    INGESTOR -->|40| EVIDX
    EVIDENCES3 -->|41| INTVERIFY
    EVIDENCES3 -->|42| CLOUDTRAIL
    INTVERIFY -->|43| CLOUDTRAIL

    %% Audit reporting
    EVIDENCES3 -->|44| AUDITMAN
    EVIDENCES3 -->|45| ATHENA
    EVIDX -->|46| ATHENA
    AUDITMAN -->|47| AUDITAPI
    ATHENA -->|48| AUDITAPI

