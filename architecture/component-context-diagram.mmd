%%{init: {'flowchart': {'nodeSpacing': 6, 'rankSpacing': 10, 'diagramPadding': 2, 'curve': 'linear'}}}%%
graph TB
    %% Edge labels: short verb phrases describe each flow; F1/F2/F3 = failure/remediation paths.
    Team[Project / Migration Team]

    subgraph Governance["Governance & Request"]
        direction LR
        SN[ServiceNow\nCatalog + CMDB]
        IH[IntegrationHub]
    end

    subgraph Pipeline["CI/CD Orchestration"]
        direction LR
        GH[GitHub\nRepository]
        GHA[GitHub Actions]
        RTCMVAL[RTCM Validator]
        IMG[Ansible Image Build]
        ANS[Ansible]
        SGATE{Security Gates\nPassed?}
    end

    subgraph Security["Security & Quality Gates"]
        direction LR
        SAST[Code Scans\nSAST + Dep + Secret]
        IAC[IaC Scans\ntfsec + Checkov]
        RTCM[RTCM\nApproved Versions]
        AMISCAN[Artifact Scans\nECR + Inspector]
        IGATE{Image Scan\nPassed?}
        RUNTIMESEC[Runtime Posture\nSecHub + GuardDuty + IAM AA]
    end

    subgraph AWS["AWS Control Plane"]
        direction LR
        OIDC[IAM OIDC\nProvider]
        SSMSESS[SSM Session\nManager]
        PARAM[SSM Parameter\nStore]
        INV[SSM\nInventory]
        AMI[Golden AMI\nRegistry]
    end

    subgraph Compliance["Compliance Evidence & Audit"]
        direction LR
        EVTBUS[EventBridge\nEvidence Bus]
        INGESTOR[Evidence Ingestor\nLambda]
        EVIDENCES3[S3 Evidence Bucket\nObject Lock + SSE-KMS]
        EVIDX[DynamoDB\nEvidence Index]
        INTVERIFY[Integrity Verifier\nLambda]
        CLOUDTRAIL[CloudTrail\nEvidence Audit]
        AUDITMAN[Audit Manager]
        ATHENA[Athena\nReport Queries]
        AUDITAPI[Auditor\nExport API]
    end

    subgraph Runtime["AWS Runtime / Build Targets"]
        direction LR
        EC2[Private Builder EC2]
        APP[Target Workloads\nWebLogic / Tomcat / Python]
    end

    %% Governance → Pipeline
    SN -.->|1. CMDB context| GHA
    SN -->|2. trigger event| IH
    IH -->|3. dispatch run| GHA
    SN -->|F3: remediation| Team

    %% Pipeline bootstrap
    GH -->|4. pipeline trigger| GHA
    GHA -->|5. request token| OIDC
    OIDC -->|6. temp credentials| GHA

    %% RTCM + security scan gates
    GH -->|7. RTCM artifact| RTCM
    PARAM -->|8. mirror baseline| RTCM
    GHA -->|9. read stack versions| RTCMVAL
    RTCM -->|10. version policy| RTCMVAL
    GHA -->|11. run code scans| SAST
    GHA -->|12. run IaC scans| IAC
    RTCMVAL -->|13. gate evidence| SGATE
    SAST -->|14. gate evidence| SGATE
    IAC -->|15. gate evidence| SGATE
    SGATE -->|16. passed: build| IMG
    SGATE -->|F1: remediation| SN

    %% Image build
    IMG -->|17. run playbook| EC2
    GHA -->|18. start session| SSMSESS
    SSMSESS -->|19. secure channel| EC2
    GHA -->|20. launch config| ANS
    ANS -->|21. configure host| EC2
    PARAM -->|22. build params| EC2

    %% AMI scan + deploy
    EC2 -->|23. publish AMI| AMI
    AMI -->|24. scan candidate| AMISCAN
    AMISCAN -->|25. scan evidence| IGATE
    IGATE -->|26. passed: deploy| APP
    IGATE -->|F2: remediation| SN
    EC2 -->|27. inventory state| INV
    INV -->|28. sync to CMDB| SN
    APP -->|29. posture telemetry| RUNTIMESEC
    RUNTIMESEC -->|30. posture feedback| SN

    %% Evidence flows
    GHA -->|31. pipeline evidence| EVTBUS
    RTCMVAL -->|32. RTCM evidence| EVTBUS
    SAST -->|33. scan evidence| EVTBUS
    IAC -->|34. IaC evidence| EVTBUS
    AMISCAN -->|35. image evidence| EVTBUS
    RUNTIMESEC -->|36. posture evidence| EVTBUS
    INV -->|37. inventory evidence| EVTBUS
    EVTBUS -->|38. validate + sign| INGESTOR
    INGESTOR -->|39. write record| EVIDENCES3
    INGESTOR -->|40. index record| EVIDX
    EVIDENCES3 -->|41. daily check| INTVERIFY
    EVIDENCES3 -->|42. S3 events| CLOUDTRAIL
    INTVERIFY -->|43. tamper alert| CLOUDTRAIL

    %% Audit reporting
    EVIDENCES3 -->|44. aggregate| AUDITMAN
    EVIDENCES3 -->|45. ad-hoc queries| ATHENA
    EVIDX -->|46. index queries| ATHENA
    AUDITMAN -->|47. report export| AUDITAPI
    ATHENA -->|48. report export| AUDITAPI

    %% actor
    style Team fill:#E1F5FE,stroke:#01579B,stroke-width:2px,color:#000
    %% governance
    style SN fill:#E8EAF6,stroke:#283593,stroke-width:2px,color:#000
    style IH fill:#E8EAF6,stroke:#283593,stroke-width:2px,color:#000
    %% pipeline
