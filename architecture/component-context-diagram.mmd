%%{init: {'flowchart': {'nodeSpacing': 6, 'rankSpacing': 10, 'diagramPadding': 2, 'curve': 'linear'}}}%%
graph TB
    %% Edge labels: 1-48 = workflow steps; F1/F2/F3 = failure paths.
    Team[Project / Migration Team]

    subgraph Governance["Governance & Request"]
        direction LR
        SN[ServiceNow\nCatalog + CMDB]
        IH[IntegrationHub]
    end

    subgraph Pipeline["CI/CD Orchestration"]
        direction LR
        GH[GitHub\nRepository]
        GHA[GitHub Actions]
        RTCMVAL[RTCM Validator]
        IMG[Ansible Image Build]
        ANS[Ansible]
        SGATE{Security Gates\nPassed?}
    end

    subgraph Security["Security & Quality Gates"]
        direction LR
        SAST[Code Scans\nSAST + Dep + Secret]
        IAC[IaC Scans\ntfsec + Checkov]
        RTCM[RTCM\nApproved Versions]
        AMISCAN[Artifact Scans\nECR + Inspector]
        IGATE{Image Scan\nPassed?}
        RUNTIMESEC[Runtime Posture\nSecHub + GuardDuty + IAM AA]
    end

    subgraph AWS["AWS Control Plane"]
        direction LR
        OIDC[IAM OIDC\nProvider]
        SSMSESS[SSM Session\nManager]
        PARAM[SSM Parameter\nStore]
        INV[SSM\nInventory]
        AMI[Golden AMI\nRegistry]
    end

    subgraph Compliance["Compliance Evidence & Audit"]
        direction LR
        EVTBUS[EventBridge\nEvidence Bus]
        INGESTOR[Evidence Ingestor\nLambda]
        EVIDENCES3[S3 Evidence Bucket\nObject Lock + SSE-KMS]
        EVIDX[DynamoDB\nEvidence Index]
        INTVERIFY[Integrity Verifier\nLambda]
        CLOUDTRAIL[CloudTrail\nEvidence Audit]
        AUDITMAN[Audit Manager]
        ATHENA[Athena\nReport Queries]
        AUDITAPI[Auditor\nExport API]
    end

    subgraph Runtime["AWS Runtime / Build Targets"]
        direction LR
        EC2[Private Builder EC2]
        APP[Target Workloads\nWebLogic / Tomcat / Python]
    end

    %% Governance → Pipeline
    SN -.->|CMDB context| GHA
    SN -->|trigger event| IH
    IH -->|dispatch run| GHA
    SN -->|F3: remediation| Team

    %% Pipeline bootstrap
    GH -->|pipeline trigger| GHA
    GHA -->|request token| OIDC
    OIDC -->|temp credentials| GHA

    %% RTCM + security scan gates
    GH -->|RTCM artifact| RTCM
    PARAM -->|mirror baseline| RTCM
    GHA -->|read stack versions| RTCMVAL
    RTCM -->|version policy| RTCMVAL
    GHA -->|run code scans| SAST
    GHA -->|run IaC scans| IAC
    RTCMVAL -->|gate evidence| SGATE
    SAST -->|gate evidence| SGATE
    IAC -->|gate evidence| SGATE
    SGATE -->|passed: build| IMG
    SGATE -->|F1: remediation| SN

    %% Image build
    IMG -->|run playbook| EC2
    GHA -->|start session| SSMSESS
    SSMSESS -->|secure channel| EC2
    GHA -->|launch config| ANS
    ANS -->|configure host| EC2
    PARAM -->|build params| EC2

    %% AMI scan + deploy
    EC2 -->|publish AMI| AMI
    AMI -->|scan candidate| AMISCAN
    AMISCAN -->|scan evidence| IGATE
    IGATE -->|passed: deploy| APP
    IGATE -->|F2: remediation| SN
    EC2 -->|inventory state| INV
    INV -->|sync to CMDB| SN
    APP -->|posture telemetry| RUNTIMESEC
    RUNTIMESEC -->|posture feedback| SN

    %% Evidence flows
    GHA -->|pipeline evidence| EVTBUS
    RTCMVAL -->|RTCM evidence| EVTBUS
    SAST -->|scan evidence| EVTBUS
    IAC -->|IaC evidence| EVTBUS
    AMISCAN -->|image evidence| EVTBUS
    RUNTIMESEC -->|posture evidence| EVTBUS
    INV -->|inventory evidence| EVTBUS
    EVTBUS -->|validate + sign| INGESTOR
    INGESTOR -->|write record| EVIDENCES3
    INGESTOR -->|index record| EVIDX
    EVIDENCES3 -->|daily check| INTVERIFY
    EVIDENCES3 -->|S3 events| CLOUDTRAIL
    INTVERIFY -->|tamper alert| CLOUDTRAIL

    %% Audit reporting
    EVIDENCES3 -->|aggregate| AUDITMAN
    EVIDENCES3 -->|ad-hoc queries| ATHENA
    EVIDX -->|index queries| ATHENA
    AUDITMAN -->|report export| AUDITAPI
    ATHENA -->|report export| AUDITAPI

    %% actor
    style Team fill:#E1F5FE,stroke:#01579B,stroke-width:2px,color:#000
    %% governance
    style SN fill:#E8EAF6,stroke:#283593,stroke-width:2px,color:#000
    style IH fill:#E8EAF6,stroke:#283593,stroke-width:2px,color:#000
    %% pipeline
    style GH fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px,color:#000
    style GHA fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px,color:#000
    style RTCMVAL fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px,color:#000
    style IMG fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px,color:#000
    style ANS fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px,color:#000
    style SGATE fill:#ffffff,stroke:#444444,stroke-width:1.5px,color:#000
    %% security
    style SAST fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    style IAC fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    style RTCM fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    style AMISCAN fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    style IGATE fill:#ffffff,stroke:#444444,stroke-width:1.5px,color:#000
    style RUNTIMESEC fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px,color:#000
    %% aws
    style OIDC fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    style SSMSESS fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    style PARAM fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    style INV fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    style AMI fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#000
    %% runtime
    style EC2 fill:#E8F5E9,stroke:#1B5E20,stroke-width:2px,color:#000
    style APP fill:#E8F5E9,stroke:#1B5E20,stroke-width:2px,color:#000
    %% compliance evidence
    style EVTBUS fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style INGESTOR fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style EVIDENCES3 fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style EVIDX fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style INTVERIFY fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style CLOUDTRAIL fill:#FCE4EC,stroke:#880E4F,stroke-width:2px,color:#000
    style AUDITMAN fill:#EDE7F6,stroke:#4A148C,stroke-width:2px,color:#000
    style ATHENA fill:#EDE7F6,stroke:#4A148C,stroke-width:2px,color:#000
    style AUDITAPI fill:#EDE7F6,stroke:#4A148C,stroke-width:2px,color:#000
