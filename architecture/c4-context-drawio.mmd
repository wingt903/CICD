graph TB
    %% C4 Context (Level 1) - draw.io compatible
    %% People
    migTeam([Migration Team])
    appTeam([Application Team])
    auditor([Auditor])

    %% System under design
    cicd[App as Code CICD Platform]

    %% External systems
    appRepos[Application Repos]
    aws[AWS Cloud]
    sn[ServiceNow]

    %% Relationships
    migTeam -->|approves promotion and remediation| cicd
    appTeam -->|pushes app, IaC, image changes| appRepos
    appRepos -->|triggers pipeline runs| cicd
    auditor -->|reads evidence and reports| cicd
    cicd -->|builds, deploys, stores artifacts| aws
    cicd -.->|creates change and remediation tickets| sn
    sn -.->|triggers runs via IntegrationHub| cicd
    sn -.->|sends remediation notices| migTeam

    %% Styling
    style cicd fill:#1168BD,color:#ffffff,stroke:#0b4884
    style migTeam fill:#08427B,color:#ffffff,stroke:#052E56
    style appTeam fill:#08427B,color:#ffffff,stroke:#052E56
    style auditor fill:#08427B,color:#ffffff,stroke:#052E56
    style appRepos fill:#999999,color:#ffffff,stroke:#666666
    style aws fill:#999999,color:#ffffff,stroke:#666666
    style sn fill:#999999,color:#ffffff,stroke:#666666
