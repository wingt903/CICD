graph TB
    %% C4 Context (Level 1) - draw.io compatible
    %% People
    migTeam([CAR Architecture Team<br/>App Owner])
    appTeam([TPAM Team<br/>Product Engineer])
    platformEngineer([App as Code Platform Engineer])
    auditor([Cyber Security Operations Analyst])

    %% System under design
    cicd[GitHub Organization-based App as Code CI/CD Platform<br/>GitHub Actions + Environments + Repo Governance]

    %% External systems
    appRepos[Application Repositories<br/>GitHub Repos]
    infraRepos[Infrastructure Repositories<br/>GitHub Repos]
    aws[AWS Target Accounts]
    sn[ServiceNow<br/>Phase 2 Integration]

    %% Relationships
    migTeam -->|approves promotions and remediations in GitHub Environments| cicd
    appTeam -->|pushes application code and config| appRepos
    platformEngineer -->|pushes OS/image IaC changes| infraRepos
    appRepos -->|triggers GitHub Actions workflows| cicd
    infraRepos -->|triggers GitHub Actions workflows| cicd
    auditor -->|reads evidence and reports| cicd
    cicd -->|builds, deploys, and stores artifacts via OIDC| aws
    cicd -.->|optional: creates change/remediation tickets| sn
    sn -.->|optional: triggers runs via IntegrationHub| cicd
    sn -.->|sends remediation notices| migTeam

    %% Styling
    style cicd fill:#1168BD,color:#ffffff,stroke:#0b4884
    style migTeam fill:#08427B,color:#ffffff,stroke:#052E56
    style appTeam fill:#08427B,color:#ffffff,stroke:#052E56
    style platformEngineer fill:#08427B,color:#ffffff,stroke:#052E56
    style auditor fill:#08427B,color:#ffffff,stroke:#052E56
    style appRepos fill:#999999,color:#ffffff,stroke:#666666
    style infraRepos fill:#999999,color:#ffffff,stroke:#666666
    style aws fill:#999999,color:#ffffff,stroke:#666666
    style sn fill:#999999,color:#ffffff,stroke:#666666
