%%{init: {'themeVariables': {'fontSize': 10}, 'flowchart': {'nodeSpacing': 8, 'rankSpacing': 12, 'diagramPadding': 2, 'curve': 'linear'}}}%%
graph TB
    %% C4 Context (Level 1) - draw.io compatible
    %% People
    migTeam([Product Engineer])
    appTeam([Product Team])
    platformEngineer([Platform Engineer])
    auditor([Cyber Security Operations Analyst])

    %% System under design
    cicd[GitHub Organization App as Code CI/CD Platform]

    %% External systems
    appRepos[Application Repositories - GitHub]
    infraRepos[Infrastructure Repositories - GitHub]
    aws[AWS Target Accounts]
    splunk[Splunk]
    grafana[Grafana]
    sn[ServiceNow - Phase 2]

    %% Relationships
    migTeam -->|approves promotions and baseline updates| cicd
    appTeam -->|pushes app code and config| appRepos
    platformEngineer -->|pushes OS/image IaC changes| infraRepos
    appRepos -->|triggers GitHub Actions| cicd
    infraRepos -->|triggers GitHub Actions| cicd
    auditor -->|reviews dashboards and audit events| cicd
    cicd -->|builds deploys and publishes approved baselines via OIDC| aws
    cicd -->|streams audit events| splunk
    cicd -->|publishes compliance dashboards| grafana
    cicd -.->|optional: creates change and remediation tickets| sn
    sn -.->|optional: triggers runs via IntegrationHub| cicd
    sn -.->|sends remediation notices| appTeam

    %% Styling
    style cicd fill:#1168BD,color:#ffffff,stroke:#0b4884
    style migTeam fill:#08427B,color:#ffffff,stroke:#052E56
    style appTeam fill:#08427B,color:#ffffff,stroke:#052E56
    style platformEngineer fill:#08427B,color:#ffffff,stroke:#052E56
    style auditor fill:#08427B,color:#ffffff,stroke:#052E56
    style appRepos fill:#999999,color:#ffffff,stroke:#666666
    style infraRepos fill:#999999,color:#ffffff,stroke:#666666
    style aws fill:#999999,color:#ffffff,stroke:#666666
    style splunk fill:#999999,color:#ffffff,stroke:#666666
    style grafana fill:#999999,color:#ffffff,stroke:#666666
    style sn fill:#999999,color:#ffffff,stroke:#666666
