%%{init: {'themeVariables': {'fontSize': 9}, 'flowchart': {'nodeSpacing': 8, 'rankSpacing': 10, 'diagramPadding': 2, 'curve': 'linear'}}}%%
graph TB
    %% C4 Container Level 2 - IPU v2 OS Upgrade as a Service Platform - draw.io compatible
    %% NOTE: This diagram is separate from the App as Code C4 container (c4-container-drawio.mmd).
    %%       It must not overwrite that diagram. Shared platform components from the App as Code
    %%       baseline are modelled as external to the IPU v2 system boundary.
    %%       Baseline reference: architecture/app-as-code-architecture-baseline.md

    %% External actors
    appTeamEngineer([Application Team Engineer])
    platformEngineer([Platform Engineer])
    cyberSecEngineer([Cyber Security Engineer])

    %% Shared platform infrastructure - App as Code baseline components
    oidcTrust["[Shared] Identity and Trust Broker<br/>AWS IAM OIDC Provider"]
    rtcmGate["[Shared] RTCM Compatibility Gate<br/>RTCM Engine + SSM Parameter Store"]
    evidencePlatform["[Shared] Audit Evidence Platform<br/>EventBridge + Lambda + S3 Object Lock + KMS"]
    auditReporting["[Shared] Audit Reporting Platform<br/>Datadog + CloudTrail + S3"]

    %% Other external systems
    awsBA["AWS EC2 Target Instances - BA Cloud<br/>EC2 + EBS + IAM Instance Profile + VPC + Security Groups"]
    awsIAG["AWS EC2 Target Instances - IAG Cloud<br/>EC2 + EBS + IAM Instance Profile + VPC + Security Groups"]
    ecpRegistry["ECP Golden Image Registry<br/>EC2 AMI Registry - BA-Approved Hardened Golden AMIs"]
    sn["ServiceNow - Phase 2"]

    %% IPU v2 System Boundary
    subgraph ipuv2 ["IPU v2 - OS Upgrade as a Service Platform"]
        intake["[1] Self-Service Upgrade Interface<br/>GitHub workflow-dispatch + Catalog Form"]
        orch["[2] IPU v2 Pipeline Orchestrator<br/>GitHub Actions IPU v2 Workflows"]
        campaign["[3] Upgrade Campaign Manager<br/>GitHub Actions Matrix + EventBridge Scheduler"]
        eligibility["[4] Pre-Upgrade Eligibility Checker<br/>Lambda + AWS Config + EC2 Describe APIs"]
        discovery["[5] Instance Configuration Discovery Engine<br/>AWS EC2 API + SSM Inventory - Non-IaC Instance Support"]
        snapshot["[6] Pre-Upgrade Snapshot Engine<br/>SSM Run Command + S3 Snapshot Store"]
        provisioner["[7] Replacement Instance Provisioner<br/>Terraform + Ansible + EC2 Launch from Golden AMI"]
        migration["[8] Data and Configuration Migration Engine<br/>Ansible + EBS Snapshot + AWS DataSync"]
        validation["[9] Post-Upgrade Validation Gate<br/>Lambda + AWS Config + SSM Run Command"]
        rollback["[10] Rollback Engine<br/>Ansible + EBS Volume Restore + SSM Run Command"]
    end

    %% External actor to intake
    appTeamEngineer -->|"upgrade request [HTTPS]"| intake
    sn -.->|"phase 2 trigger [HTTPS/API]"| intake

    %% Intake to orchestrator
    intake -->|"start workflow [Actions]"| orch

    %% Platform engineer manages campaigns
    platformEngineer -->|"manage baselines and schedule [HTTPS/Git]"| campaign
    campaign -->|"batch and sequence runs [Actions matrix]"| orch

    %% Application team approvals
    appTeamEngineer -.->|"optional approval [HTTPS/API]"| orch

    %% Orchestrator - trust and credentials
    orch -->|"OIDC to STS creds [HTTPS/OIDC]"| oidcTrust

    %% Orchestrator - step sequencing
    orch -->|"run pre-checks [AWS API]"| eligibility
    orch -->|"capture pre-snapshot [AWS SSM]"| snapshot
    orch -->|"provision replacement [AWS API/Terraform]"| provisioner
    orch -->|"run data migration [AWS API/Ansible]"| migration
    orch -->|"run post-validation [AWS API/Lambda]"| validation
    orch -->|"run rollback [AWS API/Ansible]"| rollback
    orch -->|"emit stage evidence [EventBridge]"| evidencePlatform

    %% Eligibility checker
    eligibility -->|"check OS/version vs RTCM [AWS API/SSM Parameter Store]"| rtcmGate
    eligibility -->|"read source config [EC2 API]"| awsBA
    eligibility -->|"read source config [EC2 API]"| awsIAG
    eligibility -->|"invoke non-IaC discovery [internal]"| discovery

    %% Discovery engine - non-IaC instance configuration
    discovery -->|"discover tags/IAM/SG/network [EC2 API]"| awsBA
    discovery -->|"discover tags/IAM/SG/network [EC2 API]"| awsIAG

    %% Pre-upgrade snapshot - captures pre-change state as rollback reference
    snapshot -->|"capture OS/pkg/service/config - BA [AWS SSM]"| awsBA
    snapshot -->|"capture OS/pkg/service/config - IAG [AWS SSM]"| awsIAG

    %% Replacement instance provisioner
    provisioner -->|"fetch latest approved AMI [AWS API]"| ecpRegistry
    provisioner -->|"launch replacement + copy metadata/IAM/SG/network - BA [AWS API]"| awsBA
    provisioner -->|"launch replacement + copy metadata/IAM/SG/network - IAG [AWS API]"| awsIAG

    %% Data and configuration migration
    migration -->|"mirror EBS + data check - BA [AWS API/DataSync]"| awsBA
    migration -->|"mirror EBS + data check - IAG [AWS API/DataSync]"| awsIAG

    %% Post-upgrade validation gate
    validation -->|"check OS/health/policy - BA [AWS SSM]"| awsBA
    validation -->|"check OS/health/policy - IAG [AWS SSM]"| awsIAG
    validation -->|"confirm RTCM compliance [AWS SSM]"| rtcmGate
    validation -->|"emit validation evidence [EventBridge]"| evidencePlatform

    %% Rollback engine - source instance is never modified; replacement is restored or retired
    rollback -->|"restore replacement from snapshot - BA [AWS SSM/Ansible]"| awsBA
    rollback -->|"restore replacement from snapshot - IAG [AWS SSM/Ansible]"| awsIAG
    rollback -->|"emit rollback evidence [EventBridge]"| evidencePlatform

    %% Evidence to audit reporting
    evidencePlatform -->|"store/index signed audit records [HTTPS/S3]"| auditReporting
    evidencePlatform -.->|"phase 2 status updates [HTTPS/API]"| sn

    %% Cyber security analyst access
    cyberSecEngineer -->|"read-only audit dashboards [HTTPS]"| auditReporting

    %% Styling - internal containers (IPU v2)
    style intake fill:#85BBF0,color:#000000,stroke:#5D82A8
    style orch fill:#85BBF0,color:#000000,stroke:#5D82A8
    style campaign fill:#85BBF0,color:#000000,stroke:#5D82A8
    style eligibility fill:#85BBF0,color:#000000,stroke:#5D82A8
    style discovery fill:#85BBF0,color:#000000,stroke:#5D82A8
    style snapshot fill:#85BBF0,color:#000000,stroke:#5D82A8
    style provisioner fill:#85BBF0,color:#000000,stroke:#5D82A8
    style migration fill:#85BBF0,color:#000000,stroke:#5D82A8
    style validation fill:#85BBF0,color:#000000,stroke:#5D82A8
    style rollback fill:#85BBF0,color:#000000,stroke:#5D82A8

    %% Styling - people
    style appTeamEngineer fill:#08427B,color:#ffffff,stroke:#052E56
    style platformEngineer fill:#08427B,color:#ffffff,stroke:#052E56
    style cyberSecEngineer fill:#08427B,color:#ffffff,stroke:#052E56

    %% Styling - shared App as Code platform components
    style oidcTrust fill:#6B8E6B,color:#ffffff,stroke:#4A6A4A
    style rtcmGate fill:#6B8E6B,color:#ffffff,stroke:#4A6A4A
    style evidencePlatform fill:#6B8E6B,color:#ffffff,stroke:#4A6A4A
    style auditReporting fill:#6B8E6B,color:#ffffff,stroke:#4A6A4A

    %% Styling - other external systems
    style awsBA fill:#999999,color:#ffffff,stroke:#666666
    style awsIAG fill:#999999,color:#ffffff,stroke:#666666
    style ecpRegistry fill:#999999,color:#ffffff,stroke:#666666
    style sn fill:#999999,color:#ffffff,stroke:#666666
