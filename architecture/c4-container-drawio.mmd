graph TB
    %% C4 Container (Level 2) - draw.io compatible

    %% External actors
    appOwner([App Owner])
    auditor([Cyber Security Operations Analyst])

    %% External systems
    appRepos[Application Repos]
    infraRepos[Infrastructure Repos]

    %% System boundary
    subgraph cicd ["App as Code CICD Platform"]
        templates[Governed Template Library
GitHub Template Repos + CODEOWNERS + Pinned Versions]
        orch[CI/CD Orchestration Engine
GitHub Actions]
        trust[Identity and Trust Broker
AWS IAM OIDC Provider]
        rtcm[Runtime Compatibility Validation Gate
RTCM Engine + SSM Parameter Store]
        imagebuild[Image Build and Hardening Container
Ansible + Private Builder EC2 + Golden AMI Registry]
        baseline[Approved Baseline Publisher
Release Manifest + SSM Parameter Store]
        drift[Scheduled Drift Detection
EventBridge Scheduler + Drift Scan]
        compare[State Collection and Comparison
AWS Config + SSM + Comparison Engine]
        remediate[Auto Remediation Controller
Terraform + Ansible + DB Migration]
        evidence[Audit Evidence Platform
EventBridge + Lambda + S3 Object Lock + DynamoDB + KMS]
        dashboards[Audit Reporting Platform
Splunk + Grafana + CloudTrail]
    end

    %% External interactions
    appOwner -->|1. selects governed template for app pipeline| templates
    appRepos -->|2. push / PR events| orch
    infraRepos -->|3. IaC push events| orch
    appOwner -.->|4. manual workflow_dispatch approval| orch
    appOwner -->|13. governed promotion approval| remediate
    auditor -->|18. read-only dashboard and audit access| dashboards

    %% Template governance
    templates -->|supplies governed pipeline definition and embedded controls| orch

    %% Internal interactions
    orch -->|5. exchanges OIDC token for STS credentials| trust
    orch -->|6. validates app/middleware/DB versions against approved baseline| rtcm
    rtcm -->|7. gate pass - proceeds to image build and hardening| imagebuild
    imagebuild -->|8. publishes hardened AMI and build provenance| baseline
    orch -->|9. publishes approved baseline| baseline
    baseline -->|10. supplies approved desired state| drift
    drift -->|11. schedules drift scan| compare
    compare -->|12. drift event or compliance result| evidence
    compare -->|14. triggers restore-to-baseline action| remediate
    remediate -->|15. writes remediation outcome| evidence
    orch -->|16. emits pipeline stage evidence| evidence
    evidence -->|17. stores audit records| dashboards
    evidence -->|19. streams compliance events| dashboards

    %% Styling - internal containers
    style templates fill:#85BBF0,color:#000000,stroke:#5D82A8
    style orch fill:#85BBF0,color:#000000,stroke:#5D82A8
    style trust fill:#85BBF0,color:#000000,stroke:#5D82A8
    style rtcm fill:#85BBF0,color:#000000,stroke:#5D82A8
    style imagebuild fill:#85BBF0,color:#000000,stroke:#5D82A8
    style baseline fill:#85BBF0,color:#000000,stroke:#5D82A8
    style drift fill:#85BBF0,color:#000000,stroke:#5D82A8
    style compare fill:#85BBF0,color:#000000,stroke:#5D82A8
    style remediate fill:#85BBF0,color:#000000,stroke:#5D82A8
    style evidence fill:#85BBF0,color:#000000,stroke:#5D82A8
    style dashboards fill:#85BBF0,color:#000000,stroke:#5D82A8

    %% Styling - people
    style appOwner fill:#08427B,color:#ffffff,stroke:#052E56
    style auditor fill:#08427B,color:#ffffff,stroke:#052E56

    %% Styling - external systems
    style appRepos fill:#999999,color:#ffffff,stroke:#666666
    style infraRepos fill:#999999,color:#ffffff,stroke:#666666
