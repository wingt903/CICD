graph TB
    %% C4 Container (Level 2) - draw.io compatible

    %% External actors
    appOwner([App Owner])
    auditor([Cyber Security Operations Analyst])

    %% External systems
    appRepos[Application Repos]
    infraRepos[Infrastructure Repos]

    %% System boundary
    subgraph cicd ["App as Code CICD Platform"]
        orch[CI/CD Orchestration Engine
GitHub Actions]
        trust[Identity and Trust Broker
AWS IAM OIDC Provider]
        baseline[Approved Baseline Publisher
Release Manifest + SSM Parameter Store]
        drift[Scheduled Drift Detection
EventBridge Scheduler + Drift Scan]
        compare[State Collection and Comparison
AWS Config + SSM + Comparison Engine]
        remediate[Auto Remediation Controller
Terraform + Ansible + DB Migration]
        evidence[Audit Evidence Platform
EventBridge + Lambda + S3 Object Lock + DynamoDB + KMS]
        dashboards[Audit Reporting Platform
Splunk + Grafana + CloudTrail]
    end

    %% External interactions
    appRepos -->|1. push / PR events| orch
    infraRepos -->|2. IaC push events| orch
    appOwner -.->|3. manual workflow_dispatch approval| orch
    appOwner -->|10. governed promotion approval| remediate
    auditor -->|15. read-only dashboard and audit access| dashboards

    %% Internal interactions
    orch -->|4. exchanges OIDC token for STS credentials| trust
    orch -->|5. publishes approved baseline| baseline
    baseline -->|6. supplies approved desired state| drift
    drift -->|7. schedules drift scan| compare
    compare -->|8. drift event or compliance result| evidence
    compare -->|9. triggers restore-to-baseline action| remediate
    remediate -->|11. writes remediation outcome| evidence
    orch -->|12. emits pipeline stage evidence| evidence
    evidence -->|13. stores audit records| dashboards
    evidence -->|14. streams compliance events| dashboards

    %% Styling - internal containers
    style orch fill:#85BBF0,color:#000000,stroke:#5D82A8
    style trust fill:#85BBF0,color:#000000,stroke:#5D82A8
    style baseline fill:#85BBF0,color:#000000,stroke:#5D82A8
    style drift fill:#85BBF0,color:#000000,stroke:#5D82A8
    style compare fill:#85BBF0,color:#000000,stroke:#5D82A8
    style remediate fill:#85BBF0,color:#000000,stroke:#5D82A8
    style evidence fill:#85BBF0,color:#000000,stroke:#5D82A8
    style dashboards fill:#85BBF0,color:#000000,stroke:#5D82A8

    %% Styling - people
    style appOwner fill:#08427B,color:#ffffff,stroke:#052E56
    style auditor fill:#08427B,color:#ffffff,stroke:#052E56

    %% Styling - external systems
    style appRepos fill:#999999,color:#ffffff,stroke:#666666
    style infraRepos fill:#999999,color:#ffffff,stroke:#666666
