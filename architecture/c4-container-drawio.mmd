graph TB
    %% C4 Container (Level 2) - draw.io compatible

    %% External actors
    appOwner([App Owner])
    auditor([Cyber Security Operations Analyst])

    %% External systems
    appRepos[Application Repos]
    infraRepos[Infrastructure Repos]

    %% System boundary
    subgraph cicd ["App as Code CICD Platform"]
        orch[CI/CD Orchestration Engine\nGitHub Actions]
        trust[Identity and Trust Broker\nAWS IAM OIDC Provider]
        rtcm[Runtime Compliance Gate\nRTCM Validator + SSM Parameter Store]
        build[Private Build Environment\nEC2 + Ansible + SSM Session Manager]
        artifact[Artifact Repositories\nAmazon ECR + AWS CodeArtifact]
        config[Config and Decision Store\nSSM Parameter Store + Secrets Manager]
        deploy[Deployment Controller\nGitHub Environments + Terraform + Ansible]
        secscan[Security Scanning Platform\nGHAS + tfsec + Checkov + Inspector + Security Hub]
        evidence[Compliance Evidence Platform\nEventBridge + Lambda + S3 Object Lock + DynamoDB + KMS]
        audit[Audit and Reporting Platform\nAudit Manager + Athena + CloudTrail + CloudWatch + API Gateway]
    end

    %% External interactions
    appRepos -->|[1] push / PR events| orch
    infraRepos -->|[2] IaC push events| orch
    appOwner -.->|[3] manual workflow_dispatch approval| orch
    appOwner -->|[11] promotion approval| deploy
    auditor -->|[16] read-only audit and report access| audit

    %% Internal interactions
    orch -->|[4] exchanges OIDC token for STS credentials| trust
    orch -->|[5] validates runtime baseline| rtcm
    rtcm -->|[6] reads approved baseline| config
    orch -->|[7] triggers image build| build
    build -->|[8] pushes container images and packages| artifact
    orch -->|[9] code, IaC, image, and runtime scans| secscan
    secscan -->|[10] emits security findings as evidence| evidence
    orch -->|[12] reads config and checks no-redeploy decision| deploy
    deploy -->|[13] reads config and decision records| config
    orch -->|[14] emits pipeline stage evidence| evidence
    evidence -->|[15] feeds compliance evidence for audit| audit

    %% Styling - internal containers
    style orch fill:#85BBF0,color:#000000,stroke:#5D82A8
    style trust fill:#85BBF0,color:#000000,stroke:#5D82A8
    style rtcm fill:#85BBF0,color:#000000,stroke:#5D82A8
    style build fill:#85BBF0,color:#000000,stroke:#5D82A8
    style artifact fill:#85BBF0,color:#000000,stroke:#5D82A8
    style config fill:#85BBF0,color:#000000,stroke:#5D82A8
    style deploy fill:#85BBF0,color:#000000,stroke:#5D82A8
    style secscan fill:#85BBF0,color:#000000,stroke:#5D82A8
    style evidence fill:#85BBF0,color:#000000,stroke:#5D82A8
    style audit fill:#85BBF0,color:#000000,stroke:#5D82A8

    %% Styling - people
    style appOwner fill:#08427B,color:#ffffff,stroke:#052E56
    style auditor fill:#08427B,color:#ffffff,stroke:#052E56

    %% Styling - external systems
    style appRepos fill:#999999,color:#ffffff,stroke:#666666
    style infraRepos fill:#999999,color:#ffffff,stroke:#666666
