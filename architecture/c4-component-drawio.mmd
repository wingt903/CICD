graph TB
    %% C4 Component (Level 3) - draw.io compatible
    %% External inputs
    appRepos[Application Repos]

    %% Internal components
    subgraph pipeline ["CI/CD Pipeline - GitHub Actions"]
        trigger[Trigger Handler]
        oidcMod[OIDC Auth]
        baselinePub[Baseline Publisher]
        driftSched[Scheduled Drift Scan]
        stateCollect[State Collector]
        compareEngine[Comparison Engine]
        driftDecision{Drift Found?}
        autoRemed[Auto Remediation]
        evidEmit[Evidence Emitter]
    end

    %% External AWS and GitHub systems
    oidcProv[IAM OIDC Provider]
    ssmParam[SSM Parameter Store]
    releaseManifest[Release Manifest]
    runtimeState[AWS Runtime State APIs]
    evtBus[EventBridge Evidence Bus]
    auditS3[S3 Audit and Evidence Store
Object Lock + SSE-KMS]
    datadog[Datadog]
    

    %% Relationships
    appRepos -->|push / workflow_dispatch| trigger
    trigger --> oidcMod
    oidcMod -->|exchanges OIDC for STS| oidcProv
    trigger --> baselinePub
    baselinePub -->|writes approved baseline| ssmParam
    baselinePub -->|stores release manifest| releaseManifest
    trigger --> driftSched
    driftSched -->|loads approved baseline| ssmParam
    driftSched -->|loads approved release| releaseManifest
    driftSched --> stateCollect
    runtimeState -->|live state snapshot| stateCollect
    stateCollect --> compareEngine
    compareEngine --> driftDecision
    driftDecision -->|no drift: compliant result| evidEmit
    driftDecision -->|yes: store event| evidEmit
    driftDecision -->|yes: restore baseline| autoRemed
    autoRemed -->|remediation outcome| evidEmit
    evidEmit --> evtBus
    evtBus --> auditS3
    auditS3 --> datadog
    

    %% Styling - internal components
    style trigger fill:#85BBF0,color:#000000,stroke:#5D82A8
    style oidcMod fill:#85BBF0,color:#000000,stroke:#5D82A8
    style baselinePub fill:#85BBF0,color:#000000,stroke:#5D82A8
    style driftSched fill:#85BBF0,color:#000000,stroke:#5D82A8
    style stateCollect fill:#85BBF0,color:#000000,stroke:#5D82A8
    style compareEngine fill:#85BBF0,color:#000000,stroke:#5D82A8
    style driftDecision fill:#ffffff,color:#000000,stroke:#5D82A8
    style autoRemed fill:#85BBF0,color:#000000,stroke:#5D82A8
    style evidEmit fill:#85BBF0,color:#000000,stroke:#5D82A8
    %% External systems
    style appRepos fill:#999999,color:#ffffff,stroke:#666666
    style oidcProv fill:#999999,color:#ffffff,stroke:#666666
    style ssmParam fill:#999999,color:#ffffff,stroke:#666666
    style releaseManifest fill:#999999,color:#ffffff,stroke:#666666
