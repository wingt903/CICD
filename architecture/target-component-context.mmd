graph TD
    classDef source fill:#E3F2FD,stroke:#0D47A1,stroke-width:2px;
    classDef artifact fill:#FFF3E0,stroke:#E65100,stroke-width:2px;
    classDef delivery fill:#EDE7F6,stroke:#4A148C,stroke-width:2px;
    classDef security fill:#FFEBEE,stroke:#B71C1C,stroke-width:2px;
    classDef runtime fill:#E8F5E9,stroke:#1B5E20,stroke-width:2px;

    subgraph Sources
      A1[Application as Code Repo]
      A2[OS/Image as Code Repo<br/>Ansible Image Build + Config]
      A3[Infrastructure as Code Repo<br/>Terraform]
    end

    subgraph CI and Governance
      B1[GitHub Actions Pipeline]
      B2[GitHub Environments<br/>dev/test/prod]
      B3[Release Manifest<br/>Digest + AMI + IaC Version]
      B4[RTCM Validation Gate<br/>Pre-install Runtime Policy Check]
    end

    subgraph Security and Quality Gates
      C1[SAST + Dependency + Secret Scans]
      C2[IaC Policy Scans<br/>tfsec + Checkov]
      C3[Container/AMI Scans<br/>ECR + Inspector]
      C4[Runtime Security Posture<br/>Security Hub + GuardDuty + IAM Access Analyzer]
    end

    subgraph Artifact Management
      D1[Amazon ECR<br/>Immutable Tags + Digest]
      D2[AWS CodeArtifact<br/>Python/Java Packages]
      D3[SSM Parameter Store<br/>/dev /test /prod Approved AMIs + RTCM Baseline]
      D4[SBOM + Build Provenance]
      D5[Runtime Technology Compatibility Matrix<br/>Approved App + Middleware + DB Versions]
    end

    subgraph AWS Runtime by Environment
      E1[Dev Account]
      E2[Test Account]
      E3[Prod Account]
      E4[Terraform Provisioned Runtime<br/>VPC IAM ECS/EKS/ASG ALB]
    end

    subgraph Operations and Rollback
      F1[CloudWatch + OpenTelemetry + X-Ray]
      F2[CloudWatch Alarms + SNS]
      F3[Blue/Green or Canary Rollback]
      F4[AMI Rollback via Previous Approved ID]
      F5[IaC Controlled Revert Pipeline]
    end

    subgraph Drift Detection and Reconciliation
      G1[EventBridge Scheduled Reconciliation]
      G2[Drift Reconciler Lambda/Step Function<br/>Compare Live AWS vs Git/Terraform State]
      G3[Drift Findings<br/>CloudWatch + Security Hub + CMDB]
      G4[Policy Decision and Approval Gate]
      G5[Enforce Repo Baseline<br/>Terraform Apply + Config Re-run]
      G6[Convergence Verification]
    end

    subgraph Database Drift Management
      H1[Database Drift Detector<br/>Schema + Parameter Drift]
      H2[Migration Orchestrator<br/>Versioned DB Migration Plan]
      H3[DB Rollback Path<br/>Snapshot Restore + Previous Migration]
      H4[Post-Remediation DB Validation]
    end

    subgraph Compliance Evidence Store
      I1[EventBridge Compliance Evidence Bus]
      I2[Evidence Ingestor Lambda<br/>Schema Validation + KMS Signing]
      I3[S3 Evidence Bucket<br/>Object Lock WORM + SSE-KMS + Versioning]
      I4[DynamoDB Evidence Index<br/>GSI: system_id + control_id + timestamp]
      I5[Integrity Verifier Lambda<br/>Daily Hash + Signature Verification]
      I6[CloudTrail Evidence Audit Log<br/>S3 Data Events + Management Events]
    end

    subgraph Audit Reporting
      J1[AWS Audit Manager<br/>App_as_Code Control Framework]
      J2[Athena Report Queries<br/>Current Posture + Historical Trend + Remediation]
      J3[Auditor Export API<br/>API Gateway + IAM Identity Center]
    end

